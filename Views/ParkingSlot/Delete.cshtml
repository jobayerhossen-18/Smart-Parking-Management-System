@model ParkingSlot
@{
    ViewData["Title"] = "Delete Parking Slot";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4 border-danger">
            <h3 class="text-danger mb-3"><i class="bi bi-exclamation-triangle"></i> Delete Parking Slot</h3>
            <p>Are you sure you want to delete this parking slot?</p>
            <dl class="row">
                <dt class="col-sm-4">Slot Number</dt><dd class="col-sm-8">@Model.SlotNumber</dd>
                <dt class="col-sm-4">Floor/Zone</dt><dd class="col-sm-8">@Model.Floor</dd>
                <dt class="col-sm-4">Vehicle Type</dt><dd class="col-sm-8">@Model.VehicleType</dd>
                <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd>
            </dl>
            <form asp-controller="ParkingSlot" asp-action="Delete" asp-route-id="@Model.SlotID" method="post">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-controller="ParkingSlot" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
