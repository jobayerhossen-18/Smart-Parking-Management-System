@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="admin-dashboard-page">
<div class="dashboard-header d-flex justify-content-between align-items-end mb-4 admin-dashboard-header">
    <div><span class="eyebrow">OPERATIONS CENTER</span><h1 class="fw-bold mb-1">Admin Dashboard</h1><p class="text-muted mb-0">Real-time overview of your parking facility.</p></div>
    <div class="d-none d-md-block"><a asp-controller="ParkingSlot" asp-action="Index" class="btn btn-primary"><i class="bi bi-grid-3x3-gap me-2"></i>Manage Slots</a></div>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3"><div class="premium-stat"><span>Total Revenue</span><strong>@Model.TotalRevenue.ToString("0.00") <small>BDT</small></strong><i class="bi bi-wallet2"></i></div></div>
    <div class="col-sm-6 col-xl-3"><div class="premium-stat"><span>Active Parking</span><strong>@Model.ActiveParking</strong><i class="bi bi-car-front-fill"></i></div></div>
    <div class="col-sm-6 col-xl-3"><div class="premium-stat"><span>Pending Payments</span><strong>@Model.PendingPayments</strong><i class="bi bi-hourglass-split"></i></div></div>
    <div class="col-sm-6 col-xl-3"><div class="premium-stat"><span>Total Bookings</span><strong>@Model.TotalBookings</strong><i class="bi bi-calendar-check"></i></div></div>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6"><div class="mini-stat"><small>Available</small><strong>@Model.AvailableSlots</strong></div></div>
    <div class="col-md-3 col-6"><div class="mini-stat"><small>Reserved</small><strong>@Model.ReservedSlots</strong></div></div>
    <div class="col-md-3 col-6"><div class="mini-stat"><small>Occupied</small><strong>@Model.OccupiedSlots</strong></div></div>
    <div class="col-md-3 col-6"><div class="mini-stat"><small>Slots</small><strong>@Model.TotalParkingSlots</strong></div></div>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6"><div class="mini-stat"><small>Users</small><strong>@Model.TotalUsers</strong></div></div>
    <div class="col-md-3 col-6"><div class="mini-stat"><small>Vehicles</small><strong>@Model.TotalVehicles</strong></div></div>
    <div class="col-md-3 col-6"><div class="mini-stat"><small>Completed</small><strong>@Model.CompletedBookings</strong></div></div>
    <div class="col-md-3 col-6"><div class="mini-stat"><small>Cancelled</small><strong>@Model.CancelledBookings</strong></div></div>
</div>
<div class="row g-3 admin-quick-actions">
    <div class="col-md-4"><a asp-controller="Booking" asp-action="Index" class="quick-card"><i class="bi bi-journal-check"></i><div><strong>Bookings</strong><span>Review and manage reservations</span></div><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
    <div class="col-md-4"><a asp-controller="Payment" asp-action="PaymentHistory" class="quick-card"><i class="bi bi-receipt"></i><div><strong>Payments</strong><span>Verify offline payments and receipts</span></div><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
    <div class="col-md-4"><a asp-controller="Report" asp-action="Index" class="quick-card"><i class="bi bi-bar-chart-line"></i><div><strong>Reports</strong><span>View operational and revenue reports</span></div><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
</div>

</div>
