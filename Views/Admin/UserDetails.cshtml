@model ApplicationUser
@{
    ViewData["Title"] = "User Details";
    var vehicles = (List<Vehicle>)ViewBag.Vehicles;
    var bookings = (List<Booking>)ViewBag.Bookings;
}

<h2 class="mb-3"><i class="bi bi-person-badge"></i> @Model.FullName</h2>

<div class="card p-4 mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-2">Email</dt><dd class="col-sm-4">@Model.Email</dd>
        <dt class="col-sm-2">Phone</dt><dd class="col-sm-4">@Model.PhoneNumber</dd>
        <dt class="col-sm-2">Address</dt><dd class="col-sm-4">@Model.Address</dd>
        <dt class="col-sm-2">Joined</dt><dd class="col-sm-4">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
    </dl>
</div>

<h5>Vehicles</h5>
<div class="card p-3 mb-4">
    @if (!vehicles.Any())
    {
        <p class="text-muted mb-0">No vehicles registered.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead><tr><th>Registration No.</th><th>Type</th><th>Model</th></tr></thead>
            <tbody>
                @foreach (var v in vehicles)
                {
                    <tr><td>@v.RegistrationNumber</td><td>@v.VehicleType</td><td>@v.Model</td></tr>
                }
            </tbody>
        </table>
    }
</div>

<h5>Bookings</h5>
<div class="card p-3">
    @if (!bookings.Any())
    {
        <p class="text-muted mb-0">No bookings yet.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead><tr><th>ID</th><th>Slot</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var b in bookings)
                {
                    <tr>
                        <td>#@b.BookingID</td>
                        <td>@b.ParkingSlot?.SlotNumber</td>
                        <td><span class="badge booking-badge-@b.Status">@b.Status</span></td>
                        <td><a asp-controller="Booking" asp-action="Details" asp-route-id="@b.BookingID" class="btn btn-sm btn-outline-primary">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary mt-3">Back to Users</a>
