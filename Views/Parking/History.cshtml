@model List<Booking>
@{
    ViewData["Title"] = "Parking History";
    bool isAdmin = User.IsInRole(Roles.Admin);
}

<h2 class="mb-3"><i class="bi bi-clock-history"></i> Parking History</h2>

<div class="card p-3">
    @if (!Model.Any())
    {
        <p class="text-muted text-center mb-0 py-4">No completed parking sessions yet.</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    @if (isAdmin) { <th>Customer</th> }
                    <th>Vehicle</th>
                    <th>Slot</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Duration</th>
                    <th>Fee (BDT)</th>
                    <th>Payment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>#@b.BookingID</td>
                        @if (isAdmin) { <td>@b.User?.FullName</td> }
                        <td>@b.Vehicle?.RegistrationNumber</td>
                        <td>@b.ParkingSlot?.SlotNumber</td>
                        <td>@b.ParkingSession?.CheckInTime?.ToString("dd MMM, hh:mm tt")</td>
                        <td>@b.ParkingSession?.CheckOutTime?.ToString("dd MMM, hh:mm tt")</td>
                        <td>@(b.ParkingSession?.DurationMinutes.HasValue == true ? Math.Round(b.ParkingSession.DurationMinutes.Value / 60, 2) + " hrs" : "-")</td>
                        <td class="fw-semibold">@(b.ParkingSession?.ParkingFee?.ToString("0.00") ?? "-")</td>
                        <td>
                            @if (b.Payment != null)
                            {
                                <span class="badge @(b.Payment.PaymentStatus == PaymentStatus.Paid ? "bg-success" : "bg-secondary")">@b.Payment.PaymentStatus</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
