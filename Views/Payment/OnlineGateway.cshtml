@model Payment
@{
    ViewData["Title"] = "Online Payment Gateway";
}
<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <div class="gateway-card gateway-card-colorful">
            <div class="gateway-banner text-center text-white p-4 p-md-5">
                <div class="gateway-lock gateway-lock-white"><i class="bi bi-shield-lock-fill"></i></div>
                <span class="eyebrow text-white-50">SMART PARKING CHECKOUT</span>
                <h2 class="fw-bold mt-2 mb-1">Pay @Model.Amount.ToString("0.00") BDT</h2>
                <p class="mb-0 text-white-50">Booking #@Model.BookingID · Slot @Model.Booking?.ParkingSlot?.SlotNumber</p>
            </div>
            <div class="p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Choose a payment option</h5>
                    <span class="badge text-bg-success"><i class="bi bi-lock-fill me-1"></i>Demo checkout</span>
                </div>
                @if (TempData["GatewayMessage"] != null)
                {
                    <div class="alert alert-warning small"><i class="bi bi-info-circle me-2"></i>@TempData["GatewayMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger small">@TempData["ErrorMessage"]</div>
                }
                <div class="row g-3">
                    <div class="col-md-4">
                        <form asp-action="CompleteDemoOnline" method="post" class="h-100">
                            <input type="hidden" name="id" value="@Model.PaymentID" />
                            <input type="hidden" name="provider" value="bKash" />
                            <button type="submit" class="gateway-choice gateway-choice-bkash w-100 h-100">
                                <span class="brand-dot bkash">b</span><strong>bKash</strong><small>Mobile banking</small><span class="gateway-choice-cta">Pay with bKash <i class="bi bi-arrow-right"></i></span>
                            </button>
                        </form>
                    </div>
                    <div class="col-md-4">
                        <form asp-action="CompleteDemoOnline" method="post" class="h-100">
                            <input type="hidden" name="id" value="@Model.PaymentID" />
                            <input type="hidden" name="provider" value="Nagad" />
                            <button type="submit" class="gateway-choice gateway-choice-nagad w-100 h-100">
                                <span class="brand-dot nagad">N</span><strong>Nagad</strong><small>Mobile banking</small><span class="gateway-choice-cta">Pay with Nagad <i class="bi bi-arrow-right"></i></span>
                            </button>
                        </form>
                    </div>
                    <div class="col-md-4">
                        <form asp-action="CompleteDemoOnline" method="post" class="h-100">
                            <input type="hidden" name="id" value="@Model.PaymentID" />
                            <input type="hidden" name="provider" value="Bank Card" />
                            <button type="submit" class="gateway-choice gateway-choice-card w-100 h-100">
                                <span class="brand-dot card"><i class="bi bi-credit-card-fill"></i></span><strong>Bank Card</strong><small>Visa / Mastercard</small><span class="gateway-choice-cta">Pay by card <i class="bi bi-arrow-right"></i></span>
                            </button>
                        </form>
                    </div>
                </div>
                <div class="demo-notice mt-4"><i class="bi bi-info-circle-fill me-2"></i><strong>Local demo only:</strong> clicking an option records a simulated successful payment so you can test the receipt flow. It does not contact bKash, Nagad, a bank, or charge real money. Configure a verified payment gateway before production.</div>
                <a asp-action="Pay" asp-route-id="@Model.PaymentID" class="btn btn-light border w-100 mt-3"><i class="bi bi-arrow-left me-2"></i>Back to payment methods</a>
            </div>
        </div>
    </div>
</div>
