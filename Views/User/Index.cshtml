@{
    ViewData["Title"] = "My Dashboard";
}

<div class="dashboard-header d-flex justify-content-between align-items-end mb-4">
    <div><span class="eyebrow">YOUR PARKING SPACE</span><h1 class="fw-bold mb-1">Welcome back, @ViewBag.FullName</h1><p class="text-muted mb-0">Manage vehicles, reservations, and parking sessions from one place.</p></div>
    <div class="d-none d-md-block"><a asp-controller="ParkingSlot" asp-action="AvailableSlots" class="btn btn-primary"><i class="bi bi-search me-2"></i>Find a Slot</a></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="stat-card bg-slot-total"><div class="d-flex justify-content-between align-items-center"><div><div class="small opacity-75 text-uppercase fw-bold">My Vehicles</div><h3>@ViewBag.VehicleCount</h3><div class="small opacity-75">Registered vehicles</div></div><i class="bi bi-car-front-fill fs-1"></i></div></div></div>
    <div class="col-md-4"><div class="stat-card bg-slot-reserved"><div class="d-flex justify-content-between align-items-center"><div><div class="small opacity-75 text-uppercase fw-bold">Active Bookings</div><h3>@ViewBag.ActiveBookings</h3><div class="small opacity-75">Reservations in progress</div></div><i class="bi bi-calendar2-check-fill fs-1"></i></div></div></div>
    <div class="col-md-4"><div class="stat-card bg-slot-available"><div class="d-flex justify-content-between align-items-center"><div><div class="small opacity-75 text-uppercase fw-bold">Completed Sessions</div><h3>@ViewBag.CompletedBookings</h3><div class="small opacity-75">Successful parking visits</div></div><i class="bi bi-check2-circle fs-1"></i></div></div></div>
</div>

<div class="d-flex justify-content-between align-items-end mb-3"><div><span class="eyebrow">QUICK ACTIONS</span><h2 class="fw-bold mt-1 mb-0" style="letter-spacing:-.035em;">What would you like to do?</h2></div></div>
<div class="row g-3">
    <div class="col-md-3"><a asp-controller="ParkingSlot" asp-action="AvailableSlots" class="quick-card"><i class="bi bi-search"></i><div><strong>Find a Slot</strong><span>Browse live availability</span></div><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
    <div class="col-md-3"><a asp-controller="Vehicle" asp-action="Index" class="quick-card"><i class="bi bi-car-front"></i><div><strong>My Vehicles</strong><span>Manage your vehicles</span></div><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
    <div class="col-md-3"><a asp-controller="Booking" asp-action="Index" class="quick-card"><i class="bi bi-journal-check"></i><div><strong>My Bookings</strong><span>View reservations</span></div><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
    <div class="col-md-3"><a asp-controller="Parking" asp-action="History" class="quick-card"><i class="bi bi-clock-history"></i><div><strong>Parking History</strong><span>Review past sessions</span></div><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
</div>
