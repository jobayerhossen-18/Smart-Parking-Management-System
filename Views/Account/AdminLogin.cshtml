@model LoginViewModel
@{
    ViewData["Title"] = "Admin Portal";
}
<div class="row justify-content-center py-5">
    <div class="col-lg-5">
        <div class="gateway-card">
            <div class="text-center mb-4">
                <div class="gateway-lock"><i class="bi bi-shield-lock-fill"></i></div>
                <span class="eyebrow">RESTRICTED ACCESS</span>
                <h2 class="fw-bold mt-2">Admin Portal</h2>
                <p class="text-muted mb-0">Sign in to manage parking operations, users, bookings and payments.</p>
            </div>
            <form asp-controller="Account" asp-action="AdminLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3"><label asp-for="Email" class="form-label fw-semibold"></label><input asp-for="Email" class="form-control form-control-lg" placeholder="admin@example.com" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="Password" class="form-label fw-semibold"></label><input asp-for="Password" class="form-control form-control-lg" /><span asp-validation-for="Password" class="text-danger"></span></div>
                <div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Keep me signed in</label></div>
                <button class="btn btn-primary btn-lg w-100" type="submit"><i class="bi bi-box-arrow-in-right me-2"></i>Secure Admin Login</button>
            </form>
            <div class="text-center mt-4"><a asp-controller="Account" asp-action="Login" class="text-decoration-none">← Back to Customer Login</a></div>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
