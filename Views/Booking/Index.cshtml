@model List<Booking>
@{
    ViewData["Title"] = "Bookings";
    bool isAdmin = User.IsInRole(Roles.Admin);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2><i class="bi bi-journal-check"></i> @(isAdmin ? "All Bookings" : "My Bookings")</h2>
    @if (!isAdmin)
    {
        <a asp-controller="ParkingSlot" asp-action="AvailableSlots" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Booking</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            @foreach (var st in Enum.GetValues<BookingStatus>())
            {
                if (ViewBag.StatusFilter != null && ViewBag.StatusFilter.ToString() == st.ToString())
                {
                    <option value="@st" selected>@st</option>
                }
                else
                {
                    <option value="@st">@st</option>
                }
            }
        </select>
    </div>
    @if (isAdmin)
    {
        <div class="col-auto">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by user, slot, or booking ID" style="width:280px" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Search</button>
        </div>
    }
</form>

<div class="card p-3">
    @if (!Model.Any())
    {
        <p class="text-muted text-center mb-0 py-4">No bookings found.</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    @if (isAdmin) { <th>Customer</th> }
                    <th>Vehicle</th>
                    <th>Slot</th>
                    <th>Entry</th>
                    <th>Exit</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>#@b.BookingID</td>
                        @if (isAdmin) { <td>@b.User?.FullName</td> }
                        <td>@b.Vehicle?.RegistrationNumber</td>
                        <td>@b.ParkingSlot?.SlotNumber</td>
                        <td>@b.ExpectedEntryTime.ToString("dd MMM, hh:mm tt")</td>
                        <td>@b.ExpectedExitTime.ToString("dd MMM, hh:mm tt")</td>
                        <td><span class="badge booking-badge-@b.Status">@b.Status</span></td>
                        <td class="text-end">
                            <a asp-controller="Booking" asp-action="Details" asp-route-id="@b.BookingID" class="btn btn-sm btn-outline-primary">View</a>
                            @if (!isAdmin && (b.Status == BookingStatus.Pending || b.Status == BookingStatus.Confirmed))
                            {
                                <a asp-controller="Booking" asp-action="Cancel" asp-route-id="@b.BookingID" class="btn btn-sm btn-outline-danger">Cancel</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
