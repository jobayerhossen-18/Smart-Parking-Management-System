@model Vehicle
@{
    ViewData["Title"] = "Edit Vehicle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4">
            <h3 class="mb-3"><i class="bi bi-pencil-square"></i> Edit Vehicle</h3>
            <form asp-controller="Vehicle" asp-action="Edit" asp-route-id="@Model.VehicleID" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="RegistrationNumber" class="form-label"></label>
                    <input asp-for="RegistrationNumber" class="form-control" />
                    <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="VehicleType" class="form-label"></label>
                    <select asp-for="VehicleType" asp-items="Html.GetEnumSelectList<VehicleType>()" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Color" class="form-label"></label>
                    <input asp-for="Color" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-controller="Vehicle" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
