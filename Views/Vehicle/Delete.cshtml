@model Vehicle
@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4 border-danger">
            <h3 class="text-danger mb-3"><i class="bi bi-exclamation-triangle"></i> Delete Vehicle</h3>
            <p>Are you sure you want to delete this vehicle?</p>
            <dl class="row">
                <dt class="col-sm-4">Registration No.</dt><dd class="col-sm-8">@Model.RegistrationNumber</dd>
                <dt class="col-sm-4">Type</dt><dd class="col-sm-8">@Model.VehicleType</dd>
                <dt class="col-sm-4">Model</dt><dd class="col-sm-8">@Model.Model</dd>
            </dl>
            <form asp-controller="Vehicle" asp-action="Delete" asp-route-id="@Model.VehicleID" method="post">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-controller="Vehicle" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
